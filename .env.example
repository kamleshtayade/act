# =============================================================================
# MCX Crude Agentic Paper Trading - secrets & runtime settings
# =============================================================================
# Copy to `.env` and fill in:   cp .env.example .env
# `.env` is git-ignored. NEVER commit real tokens.
#
# Every key the system can use is listed here. In APP_MODE=mock nothing below
# the "Runtime" block is required - all external calls are stubbed.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
# mock  : no external calls at all (smoke tests, CI, local dev)
# paper : real Dhan Sandbox orders + real Data API / Claude / EIA calls
# There is intentionally NO "live" mode - this project stops at the Sandbox.
APP_MODE=mock
LOG_LEVEL=INFO
DB_PATH=data/trading_log.db
CHECKPOINT_DB_PATH=data/checkpoints.db

# --- Anthropic / Claude (runtime claude_decide node) -------------------------
# Get it from https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (the decision is short; low/medium is enough)
CLAUDE_EFFORT=low
CLAUDE_MAX_TOKENS=4000
CLAUDE_TIMEOUT_SECONDS=90
# Server-side refusal fallback (beta). Set false to disable.
CLAUDE_ENABLE_SERVER_FALLBACK=true

# --- DhanHQ Sandbox (paper ORDER placement) ----------------------------------
# developer.dhanhq.co -> Sandbox -> generate client id + access token
DHAN_SANDBOX_CLIENT_ID=
DHAN_SANDBOX_ACCESS_TOKEN=
# Must point at the sandbox host - the app refuses to start otherwise.
DHAN_SANDBOX_BASE_URL=https://sandbox.dhan.co/v2

# --- DhanHQ Data API (market depth / quotes / historical) --------------------
# Paid Data API subscription on your Dhan account (~Rs 399-499/mo)
DHAN_DATA_CLIENT_ID=
DHAN_DATA_ACCESS_TOKEN=
DHAN_DATA_BASE_URL=https://api.dhan.co/v2

# --- Instrument -----------------------------------------------------------------
# From Dhan's instrument master CSV - current-month CRUDEOIL FUT security id.
# Update on every contract roll (see config/mcx_crude_contract.json).
DHAN_CRUDEOIL_SECURITY_ID=
DHAN_EXCHANGE_SEGMENT=MCX_COMM

# --- GoCharting webhook receiver ---------------------------------------------
# Random secret embedded in the webhook URL path that you paste into
# GoCharting's Alert Widget:  https://<vps-ip>:<port>/webhook/gocharting/<secret>
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(32))"
GOCHARTING_WEBHOOK_SECRET=
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8000
# Ignore repeated same-side alerts inside this window (Lipi's alertcondition +
# alert() can both fire, and real-time bars can re-fire every tick).
SIGNAL_COOLDOWN_SECONDS=300

# --- EIA (US crude inventory data) -------------------------------------------
# Free key: https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# --- Economic calendar (OPEC / Fed / inventory release dates) ----------------
# Optional. Pick one provider; leave blank to use config/event_calendar.json only.
FMP_API_KEY=
TRADING_ECONOMICS_API_KEY=
